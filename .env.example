# Better Network Tools local development defaults
# Keep scanner services on loopback. The shared launcher refuses non-loopback
# hosts even if these values are changed.
BNT_HOST=127.0.0.1
BNT_PORT=8766
BNT_WEB_HOST=127.0.0.1
BNT_WEB_PORT=3000
NEXT_PUBLIC_BNT_API_URL=http://127.0.0.1:8766

# The hosted feedback relay stores these only as server-side secrets. Never put
# the real values in NEXT_PUBLIC_* variables or commit a private key.
BNT_FEEDBACK_GITHUB_APP_PRIVATE_KEY=replace-with-github-app-private-key
BNT_FEEDBACK_RATE_LIMIT_SECRET=replace-with-at-least-32-random-bytes

# The API accepts requests only from these local development origins.
BNT_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Network job and service limits. Raise deliberately and only for authorized networks.
BNT_SCAN_HOST_LIMIT=1024
BNT_SCAN_CONCURRENCY=64
BNT_MAX_PORTS=32
BNT_PORT_SCAN_PORT_LIMIT=65535
BNT_PORT_SCAN_CONCURRENCY=128
BNT_PORT_SCAN_ACTIVE_JOB_LIMIT=2
BNT_PORT_SCAN_RESULT_LIMIT=2048
BNT_PORT_SCAN_RETAINED_JOB_LIMIT=64
BNT_PORT_SCAN_TIMEOUT_LIMIT_SECONDS=5.0
BNT_PORT_SCAN_RESOLVE_TIMEOUT_SECONDS=5.0
BNT_PORT_SCAN_TOTAL_TIMEOUT_SECONDS=900.0
BNT_PING_TARGET_LIMIT=32
BNT_PING_SAMPLE_LIMIT=100
BNT_PING_ACTIVE_JOB_LIMIT=4
BNT_PING_PROBE_CONCURRENCY=32
BNT_PING_RESOLVER_CONCURRENCY=8
BNT_PING_RESOLVE_TIMEOUT_SECONDS=5.0
BNT_PING_TIMEOUT_SECONDS=1.0
BNT_TRACE_HOP_LIMIT=64
BNT_TRACE_ACTIVE_JOB_LIMIT=2
BNT_TRACE_PROBE_TIMEOUT_LIMIT_SECONDS=5.0
BNT_TRACE_TOTAL_TIMEOUT_SECONDS=180.0
BNT_TRACE_RESOLVER_CONCURRENCY=8
BNT_TRACE_RESOLVE_TIMEOUT_SECONDS=5.0
BNT_TRACE_ASN_TIMEOUT_SECONDS=8.0
BNT_SPEED_ACTIVE_JOB_LIMIT=1
BNT_SPEED_PING_SAMPLES=6
BNT_SPEED_REQUEST_TIMEOUT_SECONDS=30.0
BNT_SPEED_TOTAL_TIMEOUT_SECONDS=90.0
BNT_SPEED_DOWNLOAD_BYTE_MINIMUM=25000000
BNT_SPEED_DOWNLOAD_BYTE_DEFAULT=250000000
BNT_SPEED_DOWNLOAD_BYTE_LIMIT=2000000000
BNT_SPEED_UPLOAD_BYTE_MINIMUM=10000000
BNT_SPEED_UPLOAD_BYTE_DEFAULT=100000000
BNT_SPEED_UPLOAD_BYTE_LIMIT=1000000000
BNT_SPEED_CATALOG_TIMEOUT_SECONDS=8.0
BNT_SPEED_DNS_TIMEOUT_SECONDS=3.0
BNT_SPEED_CATALOG_TTL_SECONDS=900
BNT_SPEED_CATALOG_MAX_BYTES=1000000
# NetTransfer runs exactly one TFTP, SFTP, or FTP server at a time. Every
# protocol uses this server-side root; the browser cannot select another path.
BNT_TRANSFER_ROOT=~/Downloads/NetTransfer
BNT_TRANSFER_BIND=127.0.0.1
BNT_TRANSFER_TFTP_PORT=6969
BNT_TRANSFER_SFTP_PORT=2222
BNT_TRANSFER_FTP_PORT=2121
BNT_TRANSFER_MAX_FILE_BYTES=1073741824
BNT_TRANSFER_ACTIVE_TRANSFER_LIMIT=16
BNT_TRANSFER_PER_CLIENT_TRANSFER_LIMIT=4
BNT_TRANSFER_ALLOWED_NETWORK_HOST_LIMIT=65536
# SFTP keeps one persistent server identity here. Only its public fingerprint is
# returned to the browser; the private key stays on the local machine.
BNT_TRANSFER_SFTP_HOST_KEY=~/.better-network-tools/nettransfer-ed25519
# FTP uses this bounded passive data-port range in addition to its control port.
# Keep it outside the control port and at least as wide as the active limit.
BNT_TRANSFER_FTP_PASSIVE_PORT_START=50000
BNT_TRANSFER_FTP_PASSIVE_PORT_END=50019
# TFTP-specific retry and RFC 2347-2349 option limits remain protocol settings.
BNT_TFTP_RETRY_TIMEOUT_SECONDS=2.0
BNT_TFTP_MAX_RETRIES=5
BNT_TFTP_TRANSFER_TIMEOUT_SECONDS=300.0
BNT_TFTP_MAX_BLOCK_SIZE=1468
# Compatibility: when the corresponding BNT_TRANSFER_* value is unset, the
# service still accepts BNT_TFTP_ROOT, BNT_TFTP_BIND, BNT_TFTP_PORT,
# BNT_TFTP_MAX_FILE_BYTES, BNT_TFTP_ACTIVE_TRANSFER_LIMIT,
# BNT_TFTP_PER_CLIENT_TRANSFER_LIMIT, and BNT_TFTP_ALLOWED_NETWORK_HOST_LIMIT.

# Updates are checked only against stable, immutable releases from this fixed
# public GitHub repository. The browser cannot supply another URL or branch.
BNT_UPDATE_REPOSITORY=erichbrinkman/betternetworktools
BNT_UPDATE_BRANCH=main
BNT_UPDATE_CHECK_TIMEOUT_SECONDS=10
BNT_UPDATE_TOTAL_CHECK_TIMEOUT_SECONDS=300
BNT_UPDATE_GIT_TIMEOUT_SECONDS=120
BNT_SSH_ACTIVE_SESSION_LIMIT=4
BNT_SSH_CONNECT_TIMEOUT_SECONDS=15.0
BNT_SSH_HANDSHAKE_TIMEOUT_SECONDS=60.0
BNT_TELNET_ACTIVE_SESSION_LIMIT=4
BNT_TELNET_CONNECT_TIMEOUT_SECONDS=15.0
BNT_TELNET_HANDSHAKE_TIMEOUT_SECONDS=60.0
BNT_TCP_TIMEOUT_SECONDS=0.75
BNT_BANNER_TIMEOUT_SECONDS=0.5
BNT_JOB_RETENTION_SECONDS=3600
